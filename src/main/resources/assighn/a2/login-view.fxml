<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.lang.String?>
<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="assighn.a2.LoginController"
      style="-fx-background-color: #f0f0f0; -fx-padding: 50;">

    <VBox alignment="CENTER" spacing="15.0"
          style="-fx-padding: 30; -fx-border-color: #ccc; -fx-border-width: 2; -fx-border-radius: 10; -fx-background-color: white; -fx-alignment: center; -fx-pref-width: 400;">

        <Label fx:id="welcomeText" text="Live Music Venue Matchmaker - Login"
               style="-fx-font-size: 22; -fx-font-weight: bold; -fx-padding: 10;"/>

        <GridPane hgap="10" vgap="10" alignment="CENTER">
            <Label text="Username:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="usernameField" GridPane.rowIndex="0" GridPane.columnIndex="1"
                       promptText="Enter your username" style="-fx-pref-width: 200;"/>

            <Label text="Password:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <PasswordField fx:id="passwordField" GridPane.rowIndex="1" GridPane.columnIndex="1"
                           promptText="Enter your password" style="-fx-pref-width: 200;"/>

            <Label text="Login as:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <ComboBox fx:id="roleComboBox" GridPane.rowIndex="2" GridPane.columnIndex="1"
                      style="-fx-pref-width: 200;">
                <items>
                    <FXCollections fx:factory="observableArrayList">
                        <String fx:value="Manager"/>
                        <String fx:value="Staff"/>
                    </FXCollections>
                </items>
            </ComboBox>
        </GridPane>

        <Button text="Login" onAction="#handleLogin"
                style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 8 16; -fx-border-radius: 5;"/>

    </VBox>
</VBox>



