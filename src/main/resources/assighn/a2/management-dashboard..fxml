<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Separator?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="assighn.a2.ManagementController"
      alignment="center"
      spacing="15"
      style="-fx-padding: 30px; -fx-background-color: #f4f4f4; -fx-border-color: #d1d1d1; -fx-border-width: 2px; -fx-border-radius: 10px;">

    <!-- Title -->
    <Label text="📊 Management Dashboard" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #333;"/>

    <Separator/>

    <!-- Reports Section -->
    <Label text="📈 Reports" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #007acc;"/>
    <HBox spacing="10">
        <Button fx:id="venueUtilizationButton" text="Venue Utilization %" onAction="#showVenueUtilization" style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
        <Button fx:id="incomeCommissionButton" text="Income and Commission" onAction="#showIncomeCommission" style="-fx-background-color: #f57c00; -fx-text-fill: white;"/>
    </HBox>

    <Separator/>

    <!-- Backup Section -->
    <Label text="💾 Backup and Restore" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #007acc;"/>
    <VBox spacing="10">
        <Button fx:id="backupButton" text="Backup to LMVM File" onAction="#backupToLMVM" style="-fx-background-color: #008CBA; -fx-text-fill: white;"/>
        <Button fx:id="loadFromBackupButton" text="Load from LMVM File" onAction="#loadFromLMVM" style="-fx-background-color: #e91e63; -fx-text-fill: white;"/>
    </VBox>

    <Separator/>

    <!-- Back Button -->
    <Button text="⬅ Back" onAction="#closeWindow" style="-fx-background-color: #777; -fx-text-fill: white;"/>
</VBox>


